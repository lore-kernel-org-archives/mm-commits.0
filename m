--- a/arch/parisc/include/asm/pgtable.h~parisc-mm-enable-arch_has_vm_get_page_prot
+++ a/arch/parisc/include/asm/pgtable.h
@@ -271,24 +271,6 @@ extern void __update_cache(pte_t pte);
  */
 
 	 /*xwr*/
-#define __P000  PAGE_NONE
