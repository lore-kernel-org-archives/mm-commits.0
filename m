 static void xor_xc_2(unsigned long bytes, unsigned long * __restrict p1,
--- a/include/linux/raid/xor.h~xor-split-xorh
+++ a/include/linux/raid/xor.h
@@ -7,24 +7,4 @@
 extern void xor_blocks(unsigned int count, unsigned int bytes,
