---

 include/linux/rmap.h |    1 +
 1 file changed, 1 insertion(+)

diff -puN include/linux/rmap.h~mm-sanitize-page-mapping-for-tail-pages-v2 include/linux/rmap.h
--- a/include/linux/rmap.h~mm-sanitize-page-mapping-for-tail-pages-v2
+++ a/include/linux/rmap.h
@@ -107,6 +107,7 @@ static inline void put_anon_vma(struct a
 
 static inline struct anon_vma *page_anon_vma(struct page *page)
 {
+	page = compound_head(page);
 	if (((unsigned long)page->mapping & PAGE_MAPPING_FLAGS) !=
 					    PAGE_MAPPING_ANON)
 		return NULL;
_

