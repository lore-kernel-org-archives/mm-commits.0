-	volatile unsigned char *acm =3D zinfo->base + ACM_OFFSET;
-	unsigned char blt_status;
-
-	if (zinfo->blitbusy) {
-		do{
-			blt_status =3D *((acm) + (ACM_START_STATUS + 2));
