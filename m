-static void parse_kbd_rate(struct kbd_repeat *r)
-{
-	if (r->delay <=3D 0)
-		r->delay =3D kbdrate.delay;
-	if (r->rate <=3D 0)
-		r->rate =3D kbdrate.rate;
-
-	if (r->delay < 5)
-		r->delay =3D 5;
-	if (r->delay > 630)
-		r->delay =3D 630;
-	if (r->rate < 12)
-		r->rate =3D 12;
-	if (r->rate > 127)
-		r->rate =3D 127;
-	if (r->rate =3D=3D 125)
-		r->rate =3D 124;
-}
-
-static int write_kbd_rate(struct kbd_repeat *rep)
-{
-	int delay, rate;
-	int i;
-
-	delay =3D rep->delay / 5;
-	rate =3D rep->rate;
-	for (i =3D 0; i < 4; i++) {
-		if (lk201_hook.poll_tx_char(lk201_handle,
-					    LK_CMD_RPT_RATE(i)))
-			return 1;
-		if (lk201_hook.poll_tx_char(lk201_handle,
-					    LK_PARAM_DELAY(delay)))
-			return 1;
-		if (lk201_hook.poll_tx_char(lk201_handle,
-					    LK_PARAM_RATE(rate)))
-			return 1;
-	}
-	return 0;
-}
-
-static int lk201_kbd_rate(struct kbd_repeat *rep)
-{
-	if (rep =3D=3D NULL)
-		return -EINVAL;
-
-	parse_kbd_rate(rep);
-
-	if (write_kbd_rate(rep)) {
-		memcpy(rep, &kbdrate, sizeof(struct kbd_repeat));
-		return -EIO;
-	}
-
-	memcpy(&kbdrate, rep, sizeof(struct kbd_repeat));
-
-	return 0;
-}
