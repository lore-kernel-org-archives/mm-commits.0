 fs/nfs/read.c |    6 ------
 1 file changed, 6 deletions(-)

diff -puN fs/nfs/read.c~nfs-remove-redundant-tests-on-reading-new-pages fs/nfs/read.c
--- a/fs/nfs/read.c~nfs-remove-redundant-tests-on-reading-new-pages
+++ a/fs/nfs/read.c
@@ -533,12 +533,6 @@ readpage_async_filler(void *data, struct
 	unsigned int len;
 	int error;
 
-	error = nfs_wb_page(inode, page);
-	if (error)
-		goto out_unlock;
-	if (PageUptodate(page))
-		goto out_unlock;
