 fs/proc/vmcore.c |   16 ++++++++--------
 1 file changed, 8 insertions(+), 8 deletions(-)

diff -puN fs/proc/vmcore.c~vmcore-count-holes-generated-by-round-up-operation-for-vmcore-size fs/proc/vmcore.c
--- a/fs/proc/vmcore.c~vmcore-count-holes-generated-by-round-up-operation-for-vmcore-size
