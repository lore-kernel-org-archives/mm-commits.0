diff -puN include/linux/oom.h~oom-deprecate-oom_adj-tunable include/linux/oom.h
--- a/include/linux/oom.h~oom-deprecate-oom_adj-tunable
+++ a/include/linux/oom.h
@@ -2,6 +2,9 @@
