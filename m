---

 kernel/taskstats.c |    2 --
 1 files changed, 2 deletions(-)

diff -puN kernel/taskstats.c~taskstats-add-all-thread-stats-for-taskstats_cmd_attr_tgid-fix kernel/taskstats.c
--- a/kernel/taskstats.c~taskstats-add-all-thread-stats-for-taskstats_cmd_attr_tgid-fix
+++ a/kernel/taskstats.c
@@ -272,9 +272,7 @@ static int fill_tgid(pid_t tgid, struct 
 		memset(stats, 0, sizeof(*stats));
 
 	leader = first->group_leader;
-	get_task_struct(leader);
 	fill_threadgroup(stats, leader);
-	put_task_struct(leader);
 
 	tsk = first;
 	do
_

