Subject: linux-next-fixups
From: Andrew Morton <akpm@linux-foundation.org>

Signed-off-by: Andrew Morton <akpm@linux-foundation.org>
---

 mm/Makefile      |    1 +
 net/sysctl_net.c |   16 +++++++---------
 2 files changed, 8 insertions(+), 9 deletions(-)

diff -puN net/sysctl_net.c~linux-next-fixups net/sysctl_net.c
--- a/net/sysctl_net.c~linux-next-fixups
+++ a/net/sysctl_net.c
@@ -29,12 +29,17 @@
 #include <linux/if_tr.h>
 #endif
 
-static struct list_head *
+static struct ctl_table_set *
 net_ctl_header_lookup(struct ctl_table_root *root, struct nsproxy *namespaces)
 {
-	return &namespaces->net_ns->sysctl_table_headers;
+	return &namespaces->net_ns->sysctls;
 }
 
+static int is_seen(struct ctl_table_set *set)
+{
+	return &current->nsproxy->net_ns->sysctls == set;
+}
+  
 /* Return standard mode bits for table entry. */
 static int net_ctl_permissions(struct ctl_table_root *root,
 			       struct nsproxy *nsproxy,
@@ -53,13 +58,6 @@ static struct ctl_table_root net_sysctl_
 	.permissions = net_ctl_permissions,
 };
 
-static LIST_HEAD(net_sysctl_ro_tables);
-static struct list_head *net_ctl_ro_header_lookup(struct ctl_table_root *root,
-		struct nsproxy *namespaces)
-{
-	return &net_sysctl_ro_tables;
-}
-
 static int net_ctl_ro_header_perms(struct ctl_table_root *root,
 		struct nsproxy *namespaces, struct ctl_table *table)
 {
diff -puN mm/Makefile~linux-next-fixups mm/Makefile
--- a/mm/Makefile~linux-next-fixups
+++ a/mm/Makefile
@@ -24,6 +24,7 @@ obj-$(CONFIG_SPARSEMEM_VMEMMAP) += spars
 obj-$(CONFIG_SHMEM) += shmem.o
 obj-$(CONFIG_TMPFS_POSIX_ACL) += shmem_acl.o
 obj-$(CONFIG_TINY_SHMEM) += tiny-shmem.o
+obj-$(CONFIG_KMEMCHECK) += kmemcheck.o
 obj-$(CONFIG_SLOB) += slob.o
 obj-$(CONFIG_SLAB) += slab.o
 obj-$(CONFIG_SLUB) += slub.o
diff -puN fs/reiserfs/journal.c~linux-next-fixups fs/reiserfs/journal.c
_

