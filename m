 drivers/rapidio/devices/tsi721.c     |  242 ++++++++++++-------------
 drivers/rapidio/devices/tsi721.h     |   40 ++++
 drivers/rapidio/devices/tsi721_dma.c |  147 ++++++++-------
 4 files changed, 249 insertions(+), 189 deletions(-)

